# KubeOne Practitioner course, Chapter 3 (Provision Infrastructure with Terraform).
#
# Values for KubeOne's Hetzner Terraform example
# (github.com/kubermatic/kubeone, examples/terraform/hetzner, tag v1.13.7).
# The lab copies that example into tf-infra/ and writes this file there as
# tf-infra/terraform.tfvars.
#
# Everything the course does not set keeps the example's default:
#   control_plane_vm_count             = 3       (three control-plane servers)
#   control_plane_type / worker_type   = "cx23"  (2 vCPU, 4 GB)
#   initial_machinedeployment_replicas = 2       (two workers, created in Chapter 4)
#   datacenter                         = "nbg1"  (a Hetzner location: Nuremberg)
#   lb_type                            = "lb11"
#
# If cx23 is not available in your location, uncomment the two lines below.
# The Hetzner API token is NOT set here. Terraform reads it from the
# HCLOUD_TOKEN environment variable.

cluster_name        = "k1-lab"
ssh_public_key_file = "~/.ssh/kubeone_lab.pub"

# control_plane_type = "cpx22"
# worker_type        = "cpx22"
