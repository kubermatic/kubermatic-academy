# KubeOne Practitioner course, Chapter 12 (Backup & User Data).
#
# Velero credentials file for velero-plugin-for-aws, used here with Hetzner
# Object Storage (an S3-compatible service). The lab guide expands this
# template with envsubst, which fills in the environment variables
# S3_ACCESS_KEY and S3_SECRET_KEY, and writes the result to
# ~/.config/kubeone-lab/credentials-velero with mode 600.
#
# Both values are the S3 credentials generated in the Hetzner Console
# (project > Security > S3 Credentials). Never commit the generated file.
[default]
aws_access_key_id=${S3_ACCESS_KEY}
aws_secret_access_key=${S3_SECRET_KEY}
